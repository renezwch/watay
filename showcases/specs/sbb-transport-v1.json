{
  "openapi": "3.1.0",
  "info": {
    "title": "SBB Swiss Public Transport API",
    "version": "1.0.0",
    "description": "Live Swiss public transport timetable, connections, locations and stationboard API (transport.opendata.ch / SBB CFF FFS)."
  },
  "servers": [
    {
      "url": "https://transport.opendata.ch"
    }
  ],
  "paths": {
    "/v1/locations": {
      "get": {
        "operationId": "searchLocations",
        "summary": "Search Swiss train stations, bus stops, POIs and addresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Location search query (e.g. Zürich HB, Bern, Basel SBB)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Location filter type (all, station, poi, address)",
            "schema": {
              "type": "string",
              "enum": ["all", "station", "poi", "address"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching locations and stations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/connections": {
      "get": {
        "operationId": "getConnections",
        "summary": "Find next public transport connections between two Swiss locations",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure station name or UIC ID (e.g. Zürich HB)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival station name or UIC ID (e.g. Bern)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of connections to return (1 - 16)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          {
            "name": "direct",
            "in": "query",
            "required": false,
            "description": "Only direct connections (0 or 1)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timetable connections between departure and arrival stations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stationboard": {
      "get": {
        "operationId": "getStationboard",
        "summary": "Live departure board (Abfahrtstafel) for a Swiss station",
        "parameters": [
          {
            "name": "station",
            "in": "query",
            "required": true,
            "description": "Station name or UIC ID (e.g. Zürich HB)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of departures to return",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station departure board entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationboardResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coordinates": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string"
          },
          "x": {
            "type": ["number", "null"]
          },
          "y": {
            "type": ["number", "null"]
          }
        }
      },
      "Location": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": {
            "type": ["string", "null"]
          },
          "name": {
            "type": ["string", "null"]
          },
          "score": {
            "type": ["number", "null"]
          },
          "coordinate": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "distance": {
            "type": ["number", "null"]
          },
          "icon": {
            "type": ["string", "null"]
          }
        }
      },
      "Prognosis": {
        "type": "object",
        "properties": {
          "platform": {
            "type": ["string", "null"]
          },
          "arrival": {
            "type": ["string", "null"]
          },
          "departure": {
            "type": ["string", "null"]
          },
          "capacity1st": {
            "type": ["integer", "null"]
          },
          "capacity2nd": {
            "type": ["integer", "null"]
          }
        }
      },
      "Checkpoint": {
        "type": "object",
        "required": ["station"],
        "properties": {
          "station": {
            "$ref": "#/components/schemas/Location"
          },
          "arrival": {
            "type": ["string", "null"]
          },
          "arrivalTimestamp": {
            "type": ["integer", "null"]
          },
          "departure": {
            "type": ["string", "null"]
          },
          "departureTimestamp": {
            "type": ["integer", "null"]
          },
          "delay": {
            "type": ["integer", "null"]
          },
          "platform": {
            "type": ["string", "null"]
          },
          "prognosis": {
            "$ref": "#/components/schemas/Prognosis"
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/Checkpoint"
          },
          "to": {
            "$ref": "#/components/schemas/Checkpoint"
          },
          "duration": {
            "type": ["string", "null"]
          },
          "transfers": {
            "type": ["integer", "null"]
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StationboardJourney": {
        "type": "object",
        "required": ["name", "to", "stop"],
        "properties": {
          "stop": {
            "$ref": "#/components/schemas/Checkpoint"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": ["string", "null"]
          },
          "number": {
            "type": ["string", "null"]
          },
          "operator": {
            "type": ["string", "null"]
          },
          "to": {
            "type": "string"
          }
        }
      },
      "LocationsResponse": {
        "type": "object",
        "required": ["stations"],
        "properties": {
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          }
        }
      },
      "ConnectionsResponse": {
        "type": "object",
        "required": ["connections"],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            }
          }
        }
      },
      "StationboardResponse": {
        "type": "object",
        "required": ["station", "stationboard"],
        "properties": {
          "station": {
            "$ref": "#/components/schemas/Location"
          },
          "stationboard": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationboardJourney"
            }
          }
        }
      }
    }
  }
}
